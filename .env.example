PIXELVAULT_ENVIRONMENT=test
PIXELVAULT_DEBUG=1
PIXELVAULT_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://pixelvault:pixelvault@127.0.0.1:55438/pixelvault
REDIS_URL=redis://127.0.0.1:56438/0
PIXELVAULT_FRONTEND_URL=http://127.0.0.1:5178
# Public pk. token only. Used by Mapbox GL JS and city/area search in the browser.
# Restrict the token to intended origins in your Mapbox account. Never use sk. keys.
VITE_MAPBOX_ACCESS_TOKEN=
# Generate a unique secret for deployments. Do not use the development fallback.
PIXELVAULT_SECRET_KEY=
# Comma-separated Fernet keys for private document encryption/key rotation.
# Test mode derives a development-only key when unset. Live mode requires keys.
PIXELVAULT_DOCUMENT_KEYS=

# Interactive marketplace: browser Maps JavaScript API key, restricted to this website/API.
# Missing/failed maps use the labeled plaza view; never reuse the Mapbox token.
VITE_GOOGLE_MAPS_API_KEY=
# Optional separate Redis endpoint; defaults to REDIS_URL, using a dedicated key namespace.
PLAZA_REDIS_URL=
# Only for explicitly authorized automated integration tests; never flush the shared database.
PLAZA_TEST_REDIS_URL=
